# ─────────────────────────────────────────────
# UmojaSACCO Backend — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git
# ─────────────────────────────────────────────

# Server
NODE_ENV=production
PORT=10000

# ── Database ──────────────────────────────────
# OPTION A: Neon / Render — use DATABASE_URL (recommended for cloud)
# Copy the "pooled connection string" from your Neon dashboard
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# OPTION B: Self-hosted PostgreSQL — use individual vars (leave DATABASE_URL blank)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=umoja_sacco
# DB_USER=your_db_user
# DB_PASSWORD=your_db_password

# JWT Authentication
JWT_SECRET=replace_with_256bit_random_string_here
JWT_REFRESH_SECRET=replace_with_another_256bit_random_string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Email (Nodemailer — use Gmail App Password or SMTP provider)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM="UmojaSACCO <noreply@umojasacco.co.ke>"

# Africa's Talking (SMS — optional)
AT_API_KEY=your_africastalking_api_key
AT_USERNAME=sandbox
AT_SENDER_ID=UMOJASACCO

# SACCO Configuration
SACCO_NAME="Umoja SACCO Society Ltd"
SACCO_REG_NO=CS/SACCO/2010/001234
SACCO_SASRA_NO=SASRA/DT/2010/0089

# File Uploads
MAX_FILE_SIZE=5242880
UPLOAD_DIR=uploads/

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Frontend URL (for CORS)
# Use your actual Vercel URL — comma-separated for multiple (e.g. production + local)
FRONTEND_URL=https://your-app.vercel.app,http://localhost:3000
